{
  "name": "melo",
  "version": "1.3.1",
  "description": "Tu musica, sin limites",
  "author": {
    "name": "Alan Lemus",
    "email": "alan.lemus.dev@gmail.com"
  },
  "main": "main.js",
  "scripts": {
    "dev": "fuser -k 5173/tcp; concurrently \"vite\" \"wait-on tcp:5173 && electron . --no-sandbox\"",
    "prebuild": "node -e \"require('fs').mkdirSync('dist/renderer', {recursive:true})\"",
    "build": "vite build && electron-builder",
    "start": "electron . --no-sandbox",
    "postinstall": "electron-builder install-app-deps",
    "release:linux": "vite build && electron-builder --linux",
    "release:mac": "vite build && electron-builder --mac",
    "release:win": "vite build && electron-builder --win",
    "release:all": "vite build && electron-builder -mwl",
    "prerelease:publish": "node -e \"require('fs').mkdirSync('dist/renderer', {recursive:true})\"",
    "release:publish": "vite build && electron-builder --publish always"
  },
  "dependencies": {
    "discord-rpc": "^4.0.1",
    "electron-store": "^8.1.0",
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.0.0",
    "cmdk": "^0.2.0",
    "concurrently": "^8.0.0",
    "cross-env": "^7.0.3",
    "electron": "https://github.com/castlabs/electron-releases#v40.7.0+wvcus",
    "electron-builder": "^24.0.0",
    "lucide-react": "^0.383.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "vite": "^5.0.0",
    "wait-on": "^7.0.0",
    "zustand": "^4.5.0"
  },
  "build": {
    "asar": false,
    "appId": "com.melo.app",
    "productName": "Melo",
    "copyright": "Copyright 2025 Melo",
    "files": [
      "main.js",
      "preload.js",
      "dist/renderer/**/*",
      "services/**/*",
      "integrations/**/*",
      "assets/icon.png",
      "assets/icon.ico",
      "electron-flags.json",
      "node_modules/**/*",
      "package.json"
    ],
    "extraResources": [],
    "extraFiles": [
      {
        "from": "packaging/melo-wrapper.sh",
        "to": "melo-wrapper"
      }
    ],
    "directories": {
      "output": "dist-electron"
    },
    "publish": {
      "provider": "github",
      "owner": "Alan14709",
      "repo": "melo",
      "releaseType": "release"
    },
    "electronDownload": {
      "mirror": "https://github.com/castlabs/electron-releases/releases/download/v"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Audio",
      "icon": "assets/icon.png",
      "executableArgs": [
        "--no-sandbox",
        "--disable-setuid-sandbox"
      ],
      "maintainer": "Alan Lemus <alan.lemus.dev@gmail.com>"
    },
    "deb": {
      "afterInstall": "packaging/deb-after-install.sh",
      "afterRemove": "packaging/deb-after-remove.sh"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.music",
      "icon": "assets/icon.png"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
